<section class="page-content">
  <div class="container container--narrow">
    <h1>{{ page.title | default: 'Kontakt' }}</h1>
    <div class="rte">{{ page.content }}</div>

    {% form 'contact', class: 'contact-form' %}
      <div class="form-row">
        <label for="ContactName">{{ 'contact.form.name' | t }}</label>
        <input type="text" id="ContactName" name="contact[name]" required>
      </div>
      <div class="form-row">
        <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
        <input type="email" id="ContactEmail" name="contact[email]" required>
      </div>
      <div class="form-row">
        <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
        <textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea>
      </div>
      <button type="submit" class="btn btn--primary btn--lg">{{ 'contact.form.send' | t }}</button>

      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'contact.form.post_success' | t }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

<style>
  .contact-form { display: grid; gap: 1rem; max-width: 540px; }
  .form-row label { display: block; margin-bottom: .35rem; font-weight: 600; }
  .form-row input, .form-row textarea { width: 100%; padding: .85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius); font: inherit; }
</style>

{% schema %}
{ "name": "Kontakt", "settings": [] }
{% endschema %}
