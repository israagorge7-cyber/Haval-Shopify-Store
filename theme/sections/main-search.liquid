<section class="search-page">
  <div class="container">
    <h1>{{ 'general.search.title' | t }}</h1>
    <form action="/search" method="get" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p>{{ 'general.search.results_with_count' | t: count: search.results_count }}</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Suche", "settings": [] }
{% endschema %}
