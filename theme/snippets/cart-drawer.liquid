<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-label="Warenkorb">
    <header class="cart-drawer__head">
      <h2>{{ 'cart.general.title' | t }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Schließen">×</button>
    </header>

    <div class="cart-drawer__shipbar" data-shipbar>
      <p data-shipbar-text></p>
      <div class="shipbar"><span data-shipbar-fill></span></div>
    </div>

    <div class="cart-drawer__body" data-cart-body>
      <p class="cart-drawer__empty" data-cart-empty>{{ 'cart.general.empty' | t }}</p>
    </div>

    <footer class="cart-drawer__foot" data-cart-foot hidden>
      <div class="cart-drawer__total">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <strong data-cart-total></strong>
      </div>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--lg btn--block">
        {{ 'cart.general.checkout' | t }}
      </a>
      <a href="{{ routes.cart_url }}" class="cart-drawer__viewlink">Warenkorb ansehen</a>
    </footer>
  </aside>
</div>
